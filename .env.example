# Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인 (robots.txt/sitemap.xml/OG 메타데이터의 절대 URL 생성에 사용)
# Vercel에 배포하면 VERCEL_URL이 자동 주입되므로 별도 설정 불필요.
# 커스텀 도메인 연결 시 VERCEL_URL이 vercel.app 서브도메인을 가리켜 실제 도메인과 달라질 수 있으니,
# 그 경우 lib/utils.ts의 getSiteUrl()에서 커스텀 도메인 환경변수를 우선 사용하도록 조정 필요

# Sentry (선택 — 비워두면 에러 모니터링이 비활성화된 채로 정상 동작)
NEXT_PUBLIC_SENTRY_DSN=
# 아래 3개는 소스맵 업로드(CI 빌드)에만 사용, 비워두면 소스맵 업로드만 건너뛰고 빌드는 정상 진행
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Google Analytics (선택 — 비워두면 분석 스크립트가 로드되지 않음)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
